{
  "type": "module",
  "description": "esmock unit tests, ava with sourcemap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iambumblehead/esmock.git"
  },
  "dependencies": {
    "esmock": "file:..",
    "@ava/typescript": "^7.0.0",
    "@tsconfig/node16": "^16.1.9",
    "@types/node": "^26.6.5",
    "ava": "^8.0.1",
    "cross-env": "^10.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "rimraf dist && tsc && cross-env NODE_NO_WARNINGS=1 ava",
    "test-no-maps": "rimraf dist && tsc --sourceMap false && cross-env NODE_OPTIONS=--loader=esmock NODE_NO_WARNINGS=1 ava"
  },
  "ava": {
    "typescript": {
      "rewritePaths": {
        "src/": "dist/"
      },
      "compile": false
    },
    "environmentVariables": {
      "NO_COLOR": "1",
      "FORCE_COLOR": "0"
    }
  }
}
